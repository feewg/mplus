{
  "name": "mplus",
  "displayName": "MPlus Extension",
  "description": "A VSCode extension for Mplus statistical software with syntax highlighting, execution, and advanced features",
  "version": "0.1.1",
  "license": "MIT-NC",
  "publisher": "feewg",
  "repository": {
    "type": "git",
    "url": "https://github.com/feewg/mplus.git"
  },
  "bugs": {
    "url": "https://github.com/feewg/mplus/issues"
  },
  "homepage": "https://github.com/feewg/mplus#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "mplus",
    "statistics",
    "structural equation modeling",
    "sem",
    "syntax highlighting"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:mplus"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mplus",
        "aliases": ["Mplus", "mplus"],
        "extensions": [".inp", ".out"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mplus",
        "scopeName": "source.mplus",
        "path": "./syntaxes/mplus.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Mplus",
      "properties": {
        "mplus.executablePath": {
          "type": "string",
          "default": "mplus",
          "description": "Mplus 可执行文件的路径"
        },
        "mplus.autoOpenOutput": {
          "type": "boolean",
          "default": true,
          "description": "执行完成后自动打开 .out 文件"
        },
        "mplus.clearTerminal": {
          "type": "boolean",
          "default": true,
          "description": "执行前清除终端"
        },
        "mplus.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "执行前自动保存文件"
        }
      }
    },
    "commands": [
      {
        "command": "mplus.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "mplus.run",
        "title": "Run Mplus",
        "icon": "$(play)"
      },
      {
        "command": "mplus.stop",
        "title": "Stop Mplus",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mplus.openOutput",
        "title": "Open Output File",
        "icon": "$(file-code)"
      },
      {
        "command": "mplus.clearTerminal",
        "title": "Clear Terminal",
        "icon": "$(trash)"
      },
      {
        "command": "mplus.newFile",
        "title": "New Mplus File",
        "icon": "$(new-file)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mplus.run",
          "when": "resourceLangId == mplus",
          "group": "navigation"
        },
        {
          "command": "mplus.stop",
          "when": "resourceLangId == mplus",
          "group": "navigation"
        },
        {
          "command": "mplus.openOutput",
          "when": "resourceLangId == mplus",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mplus.run",
          "when": "resourceLangId == mplus"
        },
        {
          "command": "mplus.stop",
          "when": "resourceLangId == mplus"
        },
        {
          "command": "mplus.openOutput",
          "when": "resourceLangId == mplus"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mplus.run",
        "key": "f5",
        "when": "resourceLangId == mplus"
      },
      {
        "command": "mplus.openOutput",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "resourceLangId == mplus"
      },
      {
        "command": "mplus.newFile",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "mplus.clearTerminal",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      }
    ],
    "snippets": [
      {
        "language": "mplus",
        "path": "./snippets/mplus.code-snippets"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.15.0"
  }
}
