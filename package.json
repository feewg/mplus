{
  "name": "mplus",
  "displayName": "MPlus Extension",
  "description": "A VSCode extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mplus",
        "aliases": ["Mplus", "mplus"],
        "extensions": [".inp"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mplus",
        "scopeName": "source.mplus",
        "path": "./syntaxes/mplus.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mplus.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "mplus.run",
        "title": "Run Mplus",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mplus.run",
          "when": "resourceLangId == mplus",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0"
  }
}
