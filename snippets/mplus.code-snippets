{
  "Title Block": {
    "prefix": "title",
    "body": [
      "TITLE: ${1:Your Title Here};"
    ],
    "description": "Mplus TITLE block"
  },
  "Data Block": {
    "prefix": "data",
    "body": [
      "DATA:",
      "  FILE IS ${1:data.dat};"
    ],
    "description": "Mplus DATA block"
  },
  "Data Imputation": {
    "prefix": "data.imputation",
    "body": [
      "DATA IMPUTATION:",
      "  IMPUTE = ${1:y1-y5};",
      "  NDATASETS = ${2:20};",
      "  NAMES = ${3:y1-y5 x1-x3};",
      "  SAVE = ${4:imputed_data.dat};"
    ],
    "description": "Mplus DATA IMPUTATION block"
  },
  "Data Imputation with Bayes": {
    "prefix": "data.imputation.bayes",
    "body": [
      "DATA IMPUTATION:",
      "  IMPUTE = ${1:u1} (c) ${2:u2} (ct) ${3:u3} (n);",
      "  NDATASETS = ${4:20};",
      "  NAMES = ${5:y1-y5 x1-x3};",
      "  SAVE = ${6:imputed_data*.dat};",
      "  SAVE = CPROBABILITIES;"
    ],
    "description": "Mplus DATA IMPUTATION with Bayes for categorical, count, and nominal variables"
  },
  "Variable Block": {
    "prefix": "variable",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:y1-y10};",
      "  USEVARIABLES ARE ${2:y1-y10};"
    ],
    "description": "Mplus VARIABLE block"
  },
  "Variable with Missing": {
    "prefix": "variable.missing",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:y1-y10};",
      "  USEVARIABLES ARE ${2:y1-y10};",
      "  MISSING ARE ALL (${3:-999});"
    ],
    "description": "Mplus VARIABLE block with missing data"
  },
  "Variable Categorical": {
    "prefix": "variable.categorical",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:u1-u10};",
      "  CATEGORICAL ARE ${2:u1-u10};"
    ],
    "description": "Mplus VARIABLE block with categorical variables"
  },
  "Variable Count": {
    "prefix": "variable.count",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:u1-u10};",
      "  COUNT ARE ${2:u1-u10};"
    ],
    "description": "Mplus VARIABLE block with count variables (Poisson)"
  },
  "Variable Count Negative Binomial": {
    "prefix": "variable.count.nb",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:u1-u10};",
      "  COUNT ARE ${2:u1-u10 (nb)};"
    ],
    "description": "Mplus VARIABLE block with negative binomial count variables"
  },
  "Variable Nominal": {
    "prefix": "variable.nominal",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:u1-u10};",
      "  NOMINAL ARE ${2:u1-u10};"
    ],
    "description": "Mplus VARIABLE block with nominal variables"
  },
  "Variable Mixture": {
    "prefix": "variable.mixture",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:y1-y5};",
      "  CLASSES = ${2:c} (${3:3});"
    ],
    "description": "Mplus VARIABLE block for mixture models"
  },
  "Variable Mixture with Auxiliary": {
    "prefix": "variable.auxiliary",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:y1-y5 x1-x3};",
      "  USEVARIABLES ARE ${2:y1-y5};",
      "  CLASSES = ${3:c} (${4:3});",
      "  AUXILIARY = ${5:x1-x3} (R3STEP);"
    ],
    "description": "Mplus VARIABLE block for mixture models with auxiliary variables"
  },
  "Variable Multilevel": {
    "prefix": "variable.multilevel",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:y x cluster};",
      "  USEVARIABLES ARE ${2:y x};",
      "  CLUSTER IS ${3:cluster};",
      "  WITHIN ARE ${4:x};"
    ],
    "description": "Mplus VARIABLE block for multilevel models"
  },
  "Variable Threelevel": {
    "prefix": "variable.threelevel",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:y x level2 level3};",
      "  USEVARIABLES ARE ${2:y x};",
      "  CLUSTER IS ${3:level3 level2};"
    ],
    "description": "Mplus VARIABLE block for three-level models"
  },
  "Variable Crossclassified": {
    "prefix": "variable.crossclassified",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:y x student school item};",
      "  USEVARIABLES ARE ${2:y x};",
      "  CLUSTER IS ${3:school item};"
    ],
    "description": "Mplus VARIABLE block for cross-classified models"
  },
  "Variable Survival": {
    "prefix": "variable.survival",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:t x};",
      "  SURVIVAL ARE ${2:t} (ALL);",
      "  TIMECENSORED ARE ${3:u} (0 = NOT 1 = RIGHT);"
    ],
    "description": "Mplus VARIABLE block for survival analysis"
  },
  "Variable DSEM": {
    "prefix": "variable.dsem",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:id time y x};",
      "  USEVARIABLES ARE ${2:y x};",
      "  CLUSTER IS ${3:id};",
      "  LAGGED = ${4:y(1) x(1)};",
      "  TINTERVAL = ${5:time (1 timeint)};"
    ],
    "description": "Mplus VARIABLE block for DSEM/RDSEM models"
  },
  "Variable CT-RDSEM": {
    "prefix": "variable.ctrdsem",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:id minutes y x};",
      "  USEVARIABLES ARE ${2:y x};",
      "  CLUSTER IS ${3:id};",
      "  LAGGED = ${4:y(1)};",
      "  CTIME = ${5:minutes};"
    ],
    "description": "Mplus VARIABLE block for Continuous-Time RDSEM"
  },
  "Define Block": {
    "prefix": "define",
    "body": [
      "DEFINE:",
      "  ${1:x_cen} = CENTER(${2:x}, GRANDMEAN);",
      "  ${3:x_std} = STANDARDIZE(${2:x});"
    ],
    "description": "Mplus DEFINE block"
  },
  "Define Cluster Mean": {
    "prefix": "define.cluster",
    "body": [
      "DEFINE:",
      "  ${1:x_cm} = CLUSTER_MEAN(${2:x});",
      "  ${3:x_cen} = CENTER(${2:x}, GROUPMEAN);"
    ],
    "description": "Mplus DEFINE block with cluster mean"
  },
  "Analysis Block": {
    "prefix": "analysis",
    "body": [
      "ANALYSIS:",
      "  TYPE = ${1:GENERAL};",
      "  ESTIMATOR = ${2:ML};"
    ],
    "description": "Mplus ANALYSIS block"
  },
  "Analysis Mixture": {
    "prefix": "analysis.mixture",
    "body": [
      "ANALYSIS:",
      "  TYPE = MIXTURE;",
      "  STARTS = ${1:500} ${2:100};"
    ],
    "description": "Mplus ANALYSIS block for mixture models"
  },
  "Analysis Twolevel": {
    "prefix": "analysis.twolevel",
    "body": [
      "ANALYSIS:",
      "  TYPE = TWOLEVEL ${1:RANDOM};",
      "  ESTIMATOR = ${2:MLR};"
    ],
    "description": "Mplus ANALYSIS block for twolevel models"
  },
  "Analysis Threelevel": {
    "prefix": "analysis.threelevel",
    "body": [
      "ANALYSIS:",
      "  TYPE = THREELEVEL ${1:RANDOM};",
      "  ESTIMATOR = ${2:MLR};"
    ],
    "description": "Mplus ANALYSIS block for three-level models"
  },
  "Analysis Crossclassified": {
    "prefix": "analysis.crossclassified",
    "body": [
      "ANALYSIS:",
      "  TYPE = CROSSCLASSIFIED ${1:RANDOM};",
      "  ESTIMATOR = ${2:MLR};"
    ],
    "description": "Mplus ANALYSIS block for cross-classified models"
  },
  "Analysis EFA": {
    "prefix": "analysis.efa",
    "body": [
      "ANALYSIS:",
      "  TYPE = EFA ${1:2} ${2:4};",
      "  ROTATION = ${3:GEOMIN};"
    ],
    "description": "Mplus ANALYSIS block for EFA"
  },
  "Analysis Bayesian": {
    "prefix": "analysis.bayes",
    "body": [
      "ANALYSIS:",
      "  ESTIMATOR = BAYES;",
      "  PROCESSORS = ${1:2};",
      "  FBITERATIONS = ${2:10000};"
    ],
    "description": "Mplus ANALYSIS block for Bayesian estimation"
  },
  "Analysis DSEM": {
    "prefix": "analysis.dsem",
    "body": [
      "ANALYSIS:",
      "  TYPE = TWOLEVEL RANDOM;",
      "  ESTIMATOR = BAYES;",
      "  PROCESSORS = ${1:2};",
      "  BITERATIONS = ${2:(5000)};"
    ],
    "description": "Mplus ANALYSIS block for DSEM"
  },
  "Analysis PSEM": {
    "prefix": "analysis.psem",
    "body": [
      "ANALYSIS:",
      "  TYPE = ${1:RANDOM};",
      "  ESTIMATOR = ${2:MLR};",
      "  PENALTY = ${3:ALF};"
    ],
    "description": "Mplus ANALYSIS block for Penalized SEM"
  },
  "Analysis Measurement Invariance": {
    "prefix": "analysis.invariance",
    "body": [
      "ANALYSIS:",
      "  TYPE = ${1:MIXTURE};",
      "  MODEL = CONFIGURAL METRIC SCALAR;",
      "  ALIGNMENT = ${2:FREE};"
    ],
    "description": "Mplus ANALYSIS block for measurement invariance testing"
  },
  "Model Block": {
    "prefix": "model",
    "body": [
      "MODEL:",
      "  ${1:f1} BY ${2:y1-y5};"
    ],
    "description": "Mplus MODEL block"
  },
  "Output Block": {
    "prefix": "output",
    "body": [
      "OUTPUT:",
      "  STDYX",
      "  TECH1",
      "  TECH8;"
    ],
    "description": "Mplus OUTPUT block"
  },
  "Output with SVALUES": {
    "prefix": "output.svalues",
    "body": [
      "OUTPUT:",
      "  STDYX",
      "  SVALUES",
      "  TECH1",
      "  TECH8;"
    ],
    "description": "Mplus OUTPUT block with SVALUES for class reordering"
  },
  "Savedata Block": {
    "prefix": "savedata",
    "body": [
      "SAVEDATA:",
      "  FILE IS ${1:results.dat};",
      "  SAVE = ${2:FSCORES};"
    ],
    "description": "Mplus SAVEDATA block"
  },
  "Savedata H5": {
    "prefix": "savedata.h5",
    "body": [
      "SAVEDATA:",
      "  H5RESULTS = ${1:results.h5};"
    ],
    "description": "Mplus SAVEDATA block with H5 output"
  },
  "Savedata Nested": {
    "prefix": "savedata.nested",
    "body": [
      "SAVEDATA:",
      "  NESTED IS ${1:nested.dat};"
    ],
    "description": "Mplus SAVEDATA block for nested model testing"
  },
  "Montecarlo Block": {
    "prefix": "montecarlo",
    "body": [
      "MONTECARLO:",
      "  NAMES ARE ${1:y1-y5};",
      "  NOBSERVATIONS = ${2:500};",
      "  NREPS = ${3:1000};",
      "  SEED = ${4:53487};"
    ],
    "description": "Mplus MONTECARLO block"
  },
  "Montecarlo with Generate": {
    "prefix": "montecarlo.generate",
    "body": [
      "MONTECARLO:",
      "  NAMES ARE ${1:y1-y5 x};",
      "  NOBSERVATIONS = ${2:500};",
      "  NREPS = ${3:1000};",
      "  SEED = ${4:53487};",
      "  GENERATE = ${5:u1-u2 (p) u3 (nb) u4 (n 2) u5 (1 l)};",
      "  CONVERGENCE = ${6:BASIC};"
    ],
    "description": "Mplus MONTECARLO block with GENERATE option"
  },
  "Plot Block": {
    "prefix": "plot",
    "body": [
      "PLOT:",
      "  TYPE = PLOT1 ${1:PLOT2 PLOT3};"
    ],
    "description": "Mplus PLOT block"
  },
  "Plot DRIFT for CT-RDSEM": {
    "prefix": "plot.drift",
    "body": [
      "PLOT:",
      "  TYPE = PLOT2;",
      "  DRIFT = ${1:(0.2 3 0.1)};"
    ],
    "description": "Mplus PLOT block with DRIFT for CT-RDSEM"
  },
  "Factor Loading": {
    "prefix": "by",
    "body": [
      "${1:factor} BY ${2:y1-y5};"
    ],
    "description": "Factor loading specification (BY)"
  },
  "Regression": {
    "prefix": "on",
    "body": [
      "${1:y} ON ${2:x};"
    ],
    "description": "Regression specification (ON)"
  },
  "Covariance": {
    "prefix": "with",
    "body": [
      "${1:x1} WITH ${2:x2};"
    ],
    "description": "Covariance specification (WITH)"
  },
  "Mean Intercept": {
    "prefix": "mean",
    "body": [
      "[${1:x}];"
    ],
    "description": "Mean/intercept specification"
  },
  "Variance": {
    "prefix": "variance",
    "body": [
      "${1:x};"
    ],
    "description": "Variance specification"
  },
  "Fix Parameter": {
    "prefix": "fix",
    "body": [
      "${1:f} BY ${2:y1}@${3:1};"
    ],
    "description": "Fix parameter to value (@)"
  },
  "Free Parameter": {
    "prefix": "free",
    "body": [
      "${1:f} BY ${2:y1}*;"
    ],
    "description": "Free parameter (*)"
  },
  "Starting Value": {
    "prefix": "start",
    "body": [
      "${1:f} BY ${2:y1}*${3:0.8};"
    ],
    "description": "Starting value for parameter"
  },
  "Equality Constraint": {
    "prefix": "equal",
    "body": [
      "${1:f} BY ${2:y1-y5} (${3:1});"
    ],
    "description": "Equality constraint"
  },
  "Model Constraint": {
    "prefix": "model.constraint",
    "body": [
      "MODEL CONSTRAINT:",
      "  NEW(${1:indirect});",
      "  ${1:indirect} = ${2:b1}*${3:b2};"
    ],
    "description": "Model constraint with NEW parameter"
  },
  "Model Test": {
    "prefix": "model.test",
    "body": [
      "MODEL TEST:",
      "  ${1:p1} = ${2:p2};"
    ],
    "description": "Model test (Wald test)"
  },
  "Model Indirect": {
    "prefix": "model.indirect",
    "body": [
      "MODEL INDIRECT:",
      "  ${1:y} IND ${2:m} ${3:x};"
    ],
    "description": "Model indirect effect"
  },
  "Model Priors": {
    "prefix": "model.priors",
    "body": [
      "MODEL PRIORS:",
      "  ${1:f} BY ${2:y1-y5} ~ N(${3:0.7}, ${4:0.1});"
    ],
    "description": "Bayesian priors"
  },
  "Model Priors PSEM": {
    "prefix": "model.priors.psem",
    "body": [
      "MODEL PRIORS:",
      "  ${1:l1-l20} ~ GEOMIN(${2:4}, ${3:1});"
    ],
    "description": "PSEM GEOMIN prior"
  },
  "CFA Model": {
    "prefix": "cfa",
    "body": [
      "MODEL:",
      "  ${1:f1} BY ${2:y1-y4};",
      "  ${3:f2} BY ${4:y5-y8};",
      "  ${5:f3} BY ${6:y9-y12};",
      "  ${1:f1}-${5:f3}@1;"
    ],
    "description": "CFA model specification"
  },
  "SEM Model": {
    "prefix": "sem",
    "body": [
      "MODEL:",
      "  ${1:f1} BY ${2:y1-y4};",
      "  ${3:f2} BY ${4:y5-y8};",
      "  ${3:f2} ON ${1:f1} ${5:x1};"
    ],
    "description": "SEM model specification"
  },
  "Growth Model": {
    "prefix": "growth",
    "body": [
      "MODEL:",
      "  ${1:i} ${2:s} | ${3:y1}@0 ${4:y2}@1 ${5:y3}@2 ${6:y4}@3;"
    ],
    "description": "Growth model specification"
  },
  "Twolevel Model": {
    "prefix": "twolevel",
    "body": [
      "MODEL:",
      "  %WITHIN%",
      "    ${1:y} ON ${2:x};",
      "  %BETWEEN%",
      "    ${1:y} ON ${3:w};"
    ],
    "description": "Twolevel model specification"
  },
  "Twolevel Random Slope": {
    "prefix": "twolevel.slope",
    "body": [
      "MODEL:",
      "  %WITHIN%",
      "    ${1:s} | ${2:y} ON ${3:x};",
      "  %BETWEEN%",
      "    ${2:y} ${1:s} ON ${4:w};",
      "    ${2:y} WITH ${1:s};"
    ],
    "description": "Twolevel random slope model"
  },
  "Threelevel Model": {
    "prefix": "threelevel",
    "body": [
      "MODEL:",
      "  %WITHIN%",
      "    ${1:y} ON ${2:x};",
      "  %BETWEEN LEVEL2%",
      "    ${1:y} ON ${3:w2};",
      "  %BETWEEN LEVEL3%",
      "    ${1:y} ON ${4:w3};"
    ],
    "description": "Three-level model specification"
  },
  "Mixture Model": {
    "prefix": "mixture",
    "body": [
      "MODEL:",
      "  %OVERALL%",
      "    ${1:f} BY ${2:y1-y5};",
      "  %c#1%",
      "    [${1:f}@0];",
      "    ${1:f}@1;",
      "  %c#2%",
      "    [${1:f}];",
      "    ${1:f};"
    ],
    "description": "Mixture model specification"
  },
  "LCA Model": {
    "prefix": "lca",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:u1-u10};",
      "  CATEGORICAL ARE ${1:u1-u10};",
      "  CLASSES = ${2:c} (${3:3});",
      "",
      "ANALYSIS:",
      "  TYPE = MIXTURE;",
      "  STARTS = 500 100;",
      "",
      "OUTPUT: TECH1 TECH8 TECH10;"
    ],
    "description": "Latent Class Analysis with categorical indicators"
  },
  "GMM Model": {
    "prefix": "gmm",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:y1-y5};",
      "  CLASSES = ${2:c} (${3:3});",
      "",
      "ANALYSIS:",
      "  TYPE = MIXTURE;",
      "  STARTS = 400 100;",
      "",
      "MODEL:",
      "  %OVERALL%",
      "    ${4:i} ${5:s} | ${1:y1}@0 ${1:y2}@1 ${1:y3}@2 ${1:y4}@3 ${1:y5}@4;",
      "  %c#1%",
      "    [${4:i} ${5:s}];",
      "    ${4:i} (1);",
      "    ${5:s} (2);"
    ],
    "description": "Growth Mixture Model with linear time scores"
  },
  "Mediation Model": {
    "prefix": "mediation",
    "body": [
      "MODEL:",
      "  ${1:y} ON ${2:m} ${3:x};",
      "  ${2:m} ON ${3:x};",
      "",
      "MODEL INDIRECT:",
      "  ${1:y} IND ${2:m} ${3:x};"
    ],
    "description": "Mediation analysis"
  },
  "Multiple Group": {
    "prefix": "multigroup",
    "body": [
      "VARIABLE:",
      "  GROUPING IS ${1:group} (${2:1}=male ${3:2}=female);",
      "",
      "MODEL:",
      "  ${4:f1} BY ${5:y1-y5};",
      "",
      "MODEL ${2:male}:",
      "  ${4:f1} BY ${5:y1-y5};",
      "",
      "MODEL ${3:female}:",
      "  ${4:f1} BY ${5:y1-y5} (1-5);"
    ],
    "description": "Multiple group analysis"
  },
  "Survival Analysis": {
    "prefix": "survival",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:t x tc};",
      "  SURVIVAL ARE ${1:t};",
      "  TIMECENSORED ARE ${2:tc} (0 = NOT 1 = RIGHT);",
      "",
      "MODEL:",
      "  ${1:t} ON ${3:x};"
    ],
    "description": "Survival analysis with right-censoring specification"
  },
  "Bayesian CFA": {
    "prefix": "bayes.cfa",
    "body": [
      "ANALYSIS:",
      "  ESTIMATOR = BAYES;",
      "  PROCESSORS = 2;",
      "",
      "MODEL:",
      "  ${1:f1} BY ${2:y1-y4}*;",
      "  ${3:f2} BY ${4:y5-y8}*;",
      "  ${1:f1}-${3:f2}@1;",
      "",
      "MODEL PRIORS:",
      "  ${1:f1} BY ${2:y1-y4} ~ N(0.7, 0.1);",
      "  ${3:f2} BY ${4:y5-y8} ~ N(0.7, 0.1);",
      "",
      "OUTPUT: STDYX TECH8;",
      "PLOT: TYPE = PLOT2;"
    ],
    "description": "Bayesian CFA"
  },
  "ESEM Model": {
    "prefix": "esem",
    "body": [
      "ANALYSIS:",
      "  TYPE = EFA ${1:2} ${2:4};",
      "  ROTATION = ${3:TARGET} (${4:OBLIQUE});",
      "",
      "MODEL:",
      "  ${5:f1}-${6:f4} BY ${7:y1-y16} (*1);"
    ],
    "description": "ESEM (Exploratory SEM)"
  },
  "Priors Normal": {
    "prefix": "prior.normal",
    "body": [
      "${1:f} BY ${2:y1-y5} ~ N(${3:0.7}, ${4:0.1});"
    ],
    "description": "Normal prior distribution"
  },
  "Priors Inverse Gamma": {
    "prefix": "prior.ig",
    "body": [
      "${1:f} ~ IG(${2:0.01}, ${3:0.01});"
    ],
    "description": "Inverse Gamma prior distribution"
  },
  "Loop Plot": {
    "prefix": "loop",
    "body": [
      "MODEL:",
      "  ${1:y} ON ${2:x} (${3:b});",
      "",
      "MODEL CONSTRAINT:",
      "  PLOT(${4:effect}) ${5:xval}*${6:xval};",
      "  LOOP(${7:x}, ${8:-2}, ${9:2}, ${10:0.1});",
      "  ${4:effect} = ${3:b}*${7:x};"
    ],
    "description": "Loop plot for moderation"
  },
  "Monte Carlo Population": {
    "prefix": "mc.population",
    "body": [
      "MONTECARLO:",
      "  NAMES ARE ${1:y1-y5} ${2:x};",
      "  NOBSERVATIONS = ${3:500};",
      "  NREPS = ${4:1000};",
      "  SEED = ${5:53487};",
      "",
      "MODEL POPULATION:",
      "  ${6:f} BY ${1:y1-y5}*0.8;",
      "  ${6:f}@1;",
      "  ${1:y1-y5}*0.36;",
      "  ${6:f} ON ${2:x}*0.5;",
      "",
      "MODEL:",
      "  ${6:f} BY ${1:y1-y5}*0.8;",
      "  ${6:f} ON ${2:x}*0.5;"
    ],
    "description": "Monte Carlo simulation with population model"
  },
  "DSEM Model": {
    "prefix": "dsem",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:id} ${2:time} ${3:y} ${4:x};",
      "  USEVARIABLES ARE ${3:y} ${4:x};",
      "  LAGGED = ${3:y}(1) ${4:x}(1);",
      "  CLUSTER IS ${1:id};",
      "",
      "ANALYSIS:",
      "  TYPE = TWOLEVEL RANDOM;",
      "  ESTIMATOR = BAYES;",
      "  PROCESSORS = 2;",
      "",
      "MODEL:",
      "  %WITHIN%",
      "    ${5:s} | ${3:y} ON ${3:y}&1;",
      "    ${3:y} ON ${4:x};",
      "  %BETWEEN%",
      "    ${3:y} ${5:s} ON ${4:x};"
    ],
    "description": "Dynamic SEM (DSEM)"
  },
  "RDSEM Model": {
    "prefix": "rdsem",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:id} ${2:time} ${3:y} ${4:x};",
      "  USEVARIABLES ARE ${3:y} ${4:x};",
      "  LAGGED = ${3:y}(1);",
      "  CLUSTER IS ${1:id};",
      "",
      "DEFINE:",
      "  CENTER ${4:x} (GROUPMEAN);",
      "",
      "ANALYSIS:",
      "  TYPE = TWOLEVEL RANDOM;",
      "  ESTIMATOR = BAYES;",
      "  PROCESSORS = 2;",
      "  BITERATIONS = (2000);",
      "",
      "MODEL:",
      "  %WITHIN%",
      "    ${5:s} | ${3:y}^ ON ${3:y}^1;",
      "    ${6:sx} | ${3:y} ON ${4:x};",
      "    ${7:logv} | ${3:y};",
      "  %BETWEEN%",
      "    ${3:y} ${5:s} ${6:sx} ${7:logv} ON ${8:w};",
      "    ${3:y} ${5:s} ${6:sx} ${7:logv} WITH ${3:y} ${5:s} ${6:sx} ${7:logv};"
    ],
    "description": "Residual Dynamic SEM (RDSEM)"
  },
  "CT-RDSEM Model": {
    "prefix": "ctrdsem",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:id} ${2:minutes} ${3:y} ${4:x};",
      "  USEVARIABLES ARE ${3:y} ${4:x};",
      "  LAGGED = ${3:y}(1);",
      "  CLUSTER IS ${1:id};",
      "  CTIME = ${2:minutes};",
      "",
      "ANALYSIS:",
      "  TYPE = TWOLEVEL RANDOM;",
      "  ESTIMATOR = BAYES;",
      "  PROCESSORS = 2;",
      "  BITERATIONS = (5000);",
      "",
      "MODEL:",
      "  %WITHIN%",
      "    ${5:s} | ${3:y}^ ON ${3:y}^1;",
      "    ${3:y} ON ${4:x};",
      "  %BETWEEN%",
      "    ${3:y} ${5:s} ON ${6:w};",
      "",
      "PLOT:",
      "  TYPE = PLOT2;",
      "  DRIFT = (0.2 3 0.1);"
    ],
    "description": "Continuous-Time Residual Dynamic SEM (CT-RDSEM)"
  },
  "PSEM Model": {
    "prefix": "psem",
    "body": [
      "ANALYSIS:",
      "  TYPE = ${1:RANDOM};",
      "  ESTIMATOR = ${2:MLR};",
      "  PENALTY = ${3:ALF};",
      "",
      "MODEL:",
      "  ${4:f1-f4} BY ${5:y1-y16} (${6:l1-l16});",
      "",
      "MODEL PRIORS:",
      "  ${6:l1-l16} ~ GEOMIN(${7:4}, ${8:1});"
    ],
    "description": "Penalized Structural Equation Modeling (PSEM)"
  },
  "Random Correlation": {
    "prefix": "random.corr",
    "body": [
      "${1:c} | ${2:y1} WITH ${3:y2};"
    ],
    "description": "Random correlation specification"
  },
  "Log Variance": {
    "prefix": "logvar",
    "body": [
      "${1:logv} | ${2:y};"
    ],
    "description": "Log variance specification for within-level residual variance"
  },
  "Alignment Analysis": {
    "prefix": "alignment",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:y1-y5 country};",
      "  USEVARIABLES ARE ${1:y1-y5};",
      "  CLUSTER = ${2:country};",
      "",
      "ANALYSIS:",
      "  TYPE = ${3:TWOLEVEL};",
      "  ALIGNMENT = ${4:FREE (*)};",
      "",
      "MODEL:",
      "  %WITHIN%",
      "    ${5:f} BY ${1:y1-y5};",
      "  %BETWEEN%",
      "    ${5:f} BY ${1:y1-y5};"
    ],
    "description": "Alignment analysis for measurement invariance"
  },
  "ESEM with Target Rotation": {
    "prefix": "esem.target",
    "body": [
      "ANALYSIS:",
      "  TYPE = EFA ${1:2} ${2:4};",
      "  ROTATION = TARGET (OBLIQUE);",
      "",
      "MODEL:",
      "  ${3:f1}-${4:f4} BY ${5:y1-y16} (${6:l1-l16});",
      "",
      "MODEL PRIORS:",
      "  ${6:l1-l16} ~ GEOMIN(${7:4}, ${8:1}, ${9:0.01});"
    ],
    "description": "ESEM with target rotation using GEOMIN prior"
  },
  "Model Population": {
    "prefix": "model.population",
    "body": [
      "MODEL POPULATION:",
      "  ${1:f} BY ${2:y1-y5}*${3:0.8};",
      "  ${1:f}@${4:1};",
      "  ${2:y1-y5}*${5:0.36};"
    ],
    "description": "Model population for Monte Carlo simulation"
  },
  "Model Coverage": {
    "prefix": "model.coverage",
    "body": [
      "MODEL COVERAGE:",
      "  ${1:f} BY ${2:y1-y5}*${3:0.8};",
      "  ${1:f}@${4:1};",
      "  ${2:y1-y5}*${5:0.36};"
    ],
    "description": "Model coverage for Monte Carlo simulation"
  },
  "Threshold Specification": {
    "prefix": "threshold",
    "body": [
      "[${1:u1}$${2:1}];"
    ],
    "description": "Threshold specification for categorical variables"
  },
  "Nominal Category": {
    "prefix": "nominal.cat",
    "body": [
      "${1:u1}#${2:1} ON ${3:x};"
    ],
    "description": "Nominal variable category specification"
  },
  "Monte Carlo Missing Pattern": {
    "prefix": "mc.patmiss",
    "body": [
      "PATMISS = ${1:y1-y4} (${2:0 0 0.1 0.2});",
      "PATPROBS = ${3:0.4 0.3 0.2 0.1};"
    ],
    "description": "Monte Carlo missing data pattern specification"
  },
  "Variable Censored": {
    "prefix": "variable.censored",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:y1-y10};",
      "  CENSORED ARE ${2:y1} (${3:b});"
    ],
    "description": "Mplus VARIABLE block with censored variables (b=bottom, t=top)"
  },
  "Variable Complex Survey": {
    "prefix": "variable.complex",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:y x w cluster};",
      "  USEVARIABLES ARE ${2:y x w};",
      "  CLUSTER IS ${3:cluster};",
      "  WEIGHT IS ${4:w};"
    ],
    "description": "Mplus VARIABLE block for complex survey data with clustering and weights"
  },
  "Analysis Complex": {
    "prefix": "analysis.complex",
    "body": [
      "ANALYSIS:",
      "  TYPE = COMPLEX;",
      "  ESTIMATOR = ${1:MLR};"
    ],
    "description": "Mplus ANALYSIS block for complex survey data"
  },
  "Data Correlation Matrix": {
    "prefix": "data.correlation",
    "body": [
      "DATA:",
      "  FILE IS ${1:data.dat};",
      "  TYPE = CORRELATION;",
      "  NOBSERVATIONS = ${2:1000};"
    ],
    "description": "Mplus DATA block for correlation matrix input"
  },
  "Data Covariance Matrix": {
    "prefix": "data.covariance",
    "body": [
      "DATA:",
      "  FILE IS ${1:data.dat};",
      "  TYPE = COVARIANCE;",
      "  NOBSERVATIONS = ${2:1000};"
    ],
    "description": "Mplus DATA block for covariance matrix input"
  },
  "Variable Auxiliary Missing": {
    "prefix": "variable.auxmissing",
    "body": [
      "VARIABLE:",
      "  NAMES ARE ${1:y1-y5 z};",
      "  USEVARIABLES ARE ${2:y1-y5};",
      "  AUXILIARY = (m) ${3:z};"
    ],
    "description": "Mplus VARIABLE block with missing data correlate (m=missing)"
  },
  "Analysis Mixture Twolevel": {
    "prefix": "analysis.mixture.twolevel",
    "body": [
      "ANALYSIS:",
      "  TYPE = TWOLEVEL MIXTURE;",
      "  STARTS = ${1:0};",
      "  INTEGRATION = ${2:15};"
    ],
    "description": "Mplus ANALYSIS block for two-level mixture models"
  },
  "Model Missing": {
    "prefix": "model.missing",
    "body": [
      "MODEL MISSING:",
      "  [${1:y1-y4}@${2:-1}];",
      "  ${1:y1} ON ${3:x}*${4:0.4};"
    ],
    "description": "Model for generating missing data in Monte Carlo simulation"
  },
  "Montecarlo Cutpoints": {
    "prefix": "mc.cutpoints",
    "body": [
      "MONTECARLO:",
      "  NAMES ARE ${1:y1-y5 x};",
      "  NOBSERVATIONS = ${2:500};",
      "  NREPS = ${3:1000};",
      "  SEED = ${4:53487};",
      "  CUTPOINTS = ${5:x}(${6:1});"
    ],
    "description": "Monte Carlo with cutpoints for creating binary variables"
  }
}
